# ==============================================================================
# SkillSphere Server Environment Variables
# ==============================================================================

# Server Runtime Configuration
PORT=3001
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/skillsphere

# JWT Authentication Secret Key (Generate a random 32+ char string in production)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# ==============================================================================
# Google OAuth 2.0 (Social Authentication)
# Obtain from https://console.cloud.google.com/apis/credentials
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==============================================================================
# Cloudinary (Cloud Media & Resume Storage)
# Obtain from https://cloudinary.com/console
# Note: If left as placeholders, the server falls back to local server/uploads/
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================================
# Razorpay Payment Gateway (Escrow & Checkout)
# Obtain from https://dashboard.razorpay.com/app/keys
# ==============================================================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==============================================================================
# Hugging Face AI (Smart Matching & Content Moderation)
# Obtain from https://huggingface.co/settings/tokens
# ==============================================================================
HUGGINGFACE_API_KEY=hf_your_huggingface_access_token

# ==============================================================================
# Transactional Email Dispatch Configuration
# ==============================================================================

# OPTION 1: Brevo (Sendinblue) API — RECOMMENDED FOR RENDER & CLOUD HOSTING
# Operates over HTTPS (Port 443 — never blocked by cloud firewalls). Free 300 emails/day.
# 1. Sign up at https://brevo.com
# 2. Generate API key from: SMTP & API -> API Keys (Full access)
# 3. Verify sender email in Brevo -> Senders
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email@gmail.com

# OPTION 2: Resend API (Alternative HTTPS-based service)
# Obtain from https://resend.com/api-keys
# RESEND_API_KEY=re_your_resend_api_key
# RESEND_FROM="SkillSphere <onboarding@resend.dev>"

# OPTION 3: Nodemailer SMTP / Gmail (WORKS IN LOCAL DEVELOPMENT ONLY)
# Note: Personal Gmail SMTP and outbound port 587/465 are blocked on Render free tier.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_google_app_password

# ==============================================================================
# Frontend URL & CORS Configuration
# ==============================================================================
# Deployed client URL (Ensures email verification & reset links point to live frontend)
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed origins for Cross-Origin Resource Sharing
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
