PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/skillsphere
JWT_SECRET=your_jwt_secret_here
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

HUGGINGFACE_API_KEY=hf_...

# ==============================================================================
# EMAIL DISPATCH CONFIGURATION
# ==============================================================================
# OPTION 1: Brevo (Sendinblue) API — RECOMMENDED FOR RENDER / CLOUD DEPLOYMENTS
# Render Free Tier blocks outbound SMTP ports (25, 465, 587).
# Brevo sends emails over HTTPS port 443 (never blocked). 300 free emails/day.
# 1. Sign up at https://brevo.com
# 2. Get API key from: SMTP & API -> API Keys
# 3. Verify your sender email (e.g. your Gmail) in Brevo -> Senders
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=your_email@gmail.com

# OPTION 2: Resend API (Alternative HTTPS-based service)
# RESEND_API_KEY=re_...
# RESEND_FROM="SkillSphere <onboarding@resend.dev>"

# OPTION 3: Nodemailer SMTP / Gmail (WORKS ON LOCALHOST ONLY)
# Note: Google blocks cloud data center IPs and Render blocks outbound SMTP ports.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_google_app_password

# ==============================================================================
# FRONTEND URL & CORS
# ==============================================================================
# Set this to your deployed Vercel frontend URL so links in emails point to your website!
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
